# Composer
/vendor/
composer.lock

# Index files generated by php-fts
search_data*/
benchmark/search_data*/
demo/search_data*/

# Indexes the benchmark builds. `*.fts` below already ignores the segments, but
# not the `commit.N` manifests beside them, so the directories are named here.
benchmark/bench_*/

# Benchmark corpora extracted from a real catalogue. The script that builds
# them is committed; the data never is — it belongs to the shop it came from.
benchmark/*.jsonl

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# PHP
*.log

# Tooling caches
.phpunit.cache/
.phpunit.result.cache

# Local scratch files and generated segments
/test.php
/scratch/
*.fts
*.fts.tmp
